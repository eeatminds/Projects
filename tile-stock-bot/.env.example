# Copy this file to .env and fill it in.

# Password for the admin page (required). Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# Shown in the bot's help message. Can also be changed later on the Settings page.
BUSINESS_NAME=Naveen Tiles

# Web port for the admin page.
PORT=3000

# Where the database and the WhatsApp login are stored. Back this folder up.
DATA_DIR=data

# Time zone for "updated today", the morning reminder and reports.
TIMEZONE=Asia/Kolkata

# 10-digit numbers typed on the admin page get this country code.
DEFAULT_COUNTRY_CODE=91

# Optional: the admin page address, added to the morning reminder message.
# PUBLIC_URL=https://stock.example.com

# Optional: set to false to run the admin page without WhatsApp (for testing).
# WHATSAPP_ENABLED=true
